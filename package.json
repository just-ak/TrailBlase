{
  "name": "trailrt",
  "version": "0.1.0",
  "private": true,
  "description": "A modern desktop replacement for Garmin BaseCamp. Local-first trip, route, track and waypoint planning.",
  "license": "GPL-3.0-or-later",
  "author": "TrailRT contributors",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:e2e",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "package": "npm run build && electron-builder --mac",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "verify:native": "electron scripts/verify-native.mjs",
    "licences": "node scripts/generate-licences.mjs",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "leaflet": "1.9.4",
    "oxlint": "1.91.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "allowScripts": {
    "electron@45.2.3": true,
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.18.20": true,
    "electron-winstaller": false
  }
}
